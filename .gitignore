# Python virtual environment
.venv/
venv/

# Python cache
__pycache__/
*.py[cod]
*.egg-info/

# Generated model inputs (regenerated by `cli.py preprocess`)
data/inputs/*
!data/inputs/.gitkeep

# Simulation trajectories — heavy binary HDF5 (regenerated by `run_forces.py`)
data/results/*
!data/results/.gitkeep

# Raw PDB downloads and TM annotations — large, from OPM GCS
data/raw/*.pdb
data/raw/*_tm.txt

# Analysis figures and caches (regenerated by analysis scripts)
data/figures/*
!data/figures/.gitkeep

# Batch log files
data/*.log
data/*.csv
data/*.txt
!data/classes/*.txt
